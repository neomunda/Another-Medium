{
    "multipart": [
        {
			"apply": { "model": "block/oxidized_copper_bars_post_ends" }
		},
        {
			"when": { "north": true, "east": false, "south": true, "west": false },
            "apply": { "model": "block/oxidized_copper_bars_post_ends", "y": 180 }
        },
        {
			"when": { "north": false, "east": true, "south": false, "west": true },
            "apply": { "model": "block/oxidized_copper_bars_post_ends", "y": 270 }
        },
        {
			"when": { "OR": [
		{ "north": true, "east": true, "south": true, "west": true },
		{ "north": false, "east": false, "south": false, "west": false },
		{ "north": true, "east": false, "south": false, "west": false },
		{ "north": false, "east": true, "south": false, "west": false },
		{ "north": false, "east": false, "south": true, "west": false },
		{ "north": false, "east": false, "south": false, "west": true },
		
		{ "north": true, "east": true, "south": false, "west": "false|true" },
		{ "north": true, "east": true, "south": "false|true", "west": false },
		
		{ "north": "false|true", "east": true, "south": true, "west": false },
		{ "north": false, "east": true, "south": true, "west": "false|true" },
		
		{ "north": "false|true", "east": false, "south": true, "west": true },
		{ "north": false, "east": "false|true", "south": true, "west": true },
		
		{ "north": true, "east": false, "south": "false|true", "west": true },
		{ "north": true, "east": "false|true", "south": false, "west": true }
		]
		},
            "apply": { "model": "block/oxidized_copper_bars_post" }
        },
        {
			"when": { "north": true },
            "apply": { "model": "block/oxidized_copper_bars_side" }
        },
        {
			"when": { "east": true },
            "apply": { "model": "block/oxidized_copper_bars_side", "y": 90 }
        },
        {
			"when": { "south": true },
            "apply": { "model": "block/oxidized_copper_bars_side_alt" }
        },
        {
			"when": { "west": true },
            "apply": { "model": "block/oxidized_copper_bars_side_alt", "y": 90 }
        }
    ]
}
