{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:axolotl/variant",
    "cases": [
      {
        "when": "blue",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/axolotlbucket_blue"
        }
        
      },
      {
        "when": "cyan",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/axolotlbucket_cyan"
        }
        
      },
      {
        "when": "gold",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/axolotlbucket_gold"
        }
        
      },
      {
          "when": "wild",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/axolotlbucket_wild"
        }

      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/axolotl_bucket"
    }
  }
}