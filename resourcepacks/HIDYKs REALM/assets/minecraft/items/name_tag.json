{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "model": "",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": [
            "Ryzhik",
            "Рыжик"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/ryzhik"
          }
        },
        {
          "when": [
            "Xleb",
            "Хлеб"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/xleb"
          }
        },
        {
          "when": [
            "Vintage Creeper",
            "Винтажный Крипер",
            "vintage creeper",
            "винтажный крипер"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/vintage_creeper"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "minecraft:item/name_tag_filled"
      }
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/name_tag"
    }
  }
}